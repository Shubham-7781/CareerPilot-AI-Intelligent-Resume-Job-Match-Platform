ENV=production
DEBUG=false

DATABASE_URL=postgresql://careerpilot:careerpilot@db:5432/careerpilot

SECRET_KEY=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost"]

MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=/app/uploads

ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Free key: https://aistudio.google.com/apikey — powers the in-depth resume analysis.
# If left blank, the app silently falls back to a basic keyword-matching analyzer.
GEMINI_API_KEY=

RATE_LIMIT_PER_MINUTE=30

REDIS_URL=redis://redis:6379/0

# Leave SMTP_HOST empty to log emails to the console instead of sending them (fine for local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@careerpilot.local
FRONTEND_URL=http://localhost:5173
EMAIL_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
